# Generated by Cargo
# will have compiled files and executables
/target/

# Cargo lock file - keep for binaries, ignore for libraries
# This is a binary project so Cargo.lock is intentionally tracked.
# Uncomment the line below if this were a library:
# Cargo.lock

# Remove Cargo.lock from gitignore if creating an executable, see:
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# LLDB debug configuration
*.lldb

# Editor & IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.local
.env.*.local

# Profiling and benchmark output
perf.data
perf.data.old
flamegraph.svg
callgrind.out.*

# Log files
*.log

# Benchmark results
/criterion/
